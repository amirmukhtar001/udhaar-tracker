{
  "expo": {
    "name": "Smart Udhaar",
    "slug": "smart-udhaar",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "smartudhaar",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "bundleIdentifier": "com.udhaartracker.app",
      "buildNumber": "1.0.1",
      "supportsTablet": false
    },
    "android": {
      "package": "com.udhaartracker.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": ["POST_NOTIFICATIONS"]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#2563eb"
        }
      ]
    ],
    "extra": {
      "supportEmail": "support@udhaartracker.app",
      "privacyPolicyUrl": "https://udhaartracker.app/privacy-policy",
      "accountDeletionUrl": "https://udhaartracker.app/account-deletion"
    }
  }
}
